# ── Required ────────────────────────────────────────────────
# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://jjqvvreeurbarauyeysa.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Google AI Studio (https://aistudio.google.com/apikey) — chat + embeddings
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Recommended ─────────────────────────────────────────────
# Public URL used in emails and OAuth redirects
NEXT_PUBLIC_SITE_URL=https://agentforge-nu-seven.vercel.app
# 32+ random characters; encrypts OAuth tokens at rest
ENCRYPTION_KEY=

# ── Optional features (see docs/SETUP-INTEGRATIONS.md) ─────
# Email (invites, approval notifications, "Send email" tool)
RESEND_API_KEY=
EMAIL_FROM="AgentForge <noreply@yourdomain.com>"
# Gmail + Google Sheets tools
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Notion tools
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Show "Continue with Google" (after enabling the Google provider in Supabase)
NEXT_PUBLIC_AUTH_GOOGLE=false
# Daily Vercel Cron fallback for schedules when Inngest isn't installed
CRON_SECRET=

# Inngest: local → run `npx inngest-cli@latest dev` and set INNGEST_DEV=1
# Production → set automatically by the Inngest ↔ Vercel integration
# INNGEST_DEV=1
